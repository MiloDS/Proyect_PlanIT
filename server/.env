# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Conexión a Base de Datos PostgreSQL
DATABASE_URL=postgresql://postgres:1234@localhost:5432/planit

# Parámetros individuales de PostgreSQL (alternativa a DATABASE_URL)
PGUSER=postgres
PGPASSWORD=1234
PGHOST=localhost
PGPORT=5432
PGDATABASE=planit

# Seguridad y Tokens JWT
JWT_ACCESS_SECRET=super_secret_access_key_planit_app_2026
JWT_REFRESH_SECRET=super_secret_refresh_key_planit_app_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
