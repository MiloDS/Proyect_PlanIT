# Copia este archivo como .env y completa los valores de tu proyecto de Supabase
# (Dashboard → Project Settings → API).
# Usa solo la clave pública (anon / publishable), nunca la service_role / secret:
# todo lo que empieza por EXPO_PUBLIC_ queda incluido dentro de la app.
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo para compilar el APK (Expo Go no la necesita): key de "Maps SDK for Android" para el
# mapa de Buscar. Ver "Generar el APK" en el README.
GOOGLE_MAPS_ANDROID_API_KEY=
